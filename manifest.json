{
  "manifest_version": 3,
  "name": "VoidTab",
  "version": "1.1.0",
  "description": "Your personal productivity new tab — bookmark boards, tab grouping, and AI coaching.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "bookmarks",
    "search",
    "sessions"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VoidTab"
  }
}
